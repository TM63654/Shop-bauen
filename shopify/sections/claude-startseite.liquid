{%- render 'claude-header', active: 'startseite' -%}

<main id="main">

  <!-- 1. Hero: Glied 1+2 der Glaubenskette -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Chronischer Fersenschmerz</span>
        <h1>Der erste Schritt aus dem Bett fühlt sich an, als würden Sie in einen Nagel treten?</h1>
        <p class="hero-lede">Dann gehören Sie zu denen, bei denen es <strong>nicht von allein</strong> weggegangen ist – und das liegt nicht an Ihnen.</p>
        <div class="hero-ctas">
          <a href="/products/pedivita-fersenhalt" class="btn btn-primary">Zum Produkt</a>
          <a href="#warum" class="btn btn-secondary">Warum nichts geholfen hat</a>
        </div>
      </div>
      <div class="img-placeholder" role="img" aria-label="[PLATZHALTER: Produktbild – AktivFuß Bandage am Fuß, ruhige Alltagssituation]">
        [PLATZHALTER: Produktbild<br>Bandage am Fuß, Alltagsszene]
      </div>
    </div>
  </section>

  <!-- 2. Warum nichts geholfen hat – Fasziose-Reframe (Glied 2) -->
  <section id="warum" class="section section--alt">
    <div class="container split">
      <div>
        <span class="eyebrow">Die Erklärung, die meist fehlt</span>
        <h2>Warum Eis, Salbe und Einlagen allein oft nicht reichen</h2>
        <p>Bei den meisten hartnäckigen Fersenschmerzen handelt es sich nicht um eine akute Entzündung, sondern um überlastetes, verändertes Gewebe am Sehnenansatz – in der Medizin als Fasziose bezeichnet. Entzündungshemmende Mittel setzen dort an, wo eigentlich Entlastung gebraucht wird.</p>
        <p>Das bedeutet nicht, dass bisherige Versuche falsch waren – nur, dass sie an der falschen Stelle ansetzen mussten. Mehr dazu und was das für Sie bedeutet, lesen Sie auf der Produktseite.</p>
        <a href="/products/pedivita-fersenhalt#mechanismus" class="btn btn-secondary" style="margin-top: var(--space-2);">Mechanismus verstehen</a>
      </div>
      <div class="img-placeholder" role="img" aria-label="[PLATZHALTER: Illustration Sehnenansatz Ferse]">
        [PLATZHALTER: Erklärgrafik<br>Fersenbein &amp; Sehnenansatz]
      </div>
    </div>
  </section>

  <!-- 3. Die Bandage im Alltag – 3 Kacheln -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Alltagstauglich statt aufwendig</span>
        <h2>Gebaut für einen Alltag, der weitergehen muss</h2>
      </div>
      <div class="tile-grid">
        <div class="tile">
          <div class="tile-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="2.5"/></svg>
          </div>
          <h3>Passt in den Schuh</h3>
          <p>Flach genug für Straßenschuh, Arbeitsschuh und viele Hausschuhe – niemand sieht sie unter der Kleidung oder im Schuh.</p>
        </div>
        <div class="tile">
          <div class="tile-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
          </div>
          <h3>Morgens anziehen, vergessen</h3>
          <p>Keine Übung, an die Sie denken müssen. Anziehen, in den Schuh, den Tag leben – das war's.</p>
        </div>
        <div class="tile">
          <div class="tile-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h3>Kombinierbar</h3>
          <p>Lässt sich mit Ihren Einlagen und Dehnübungen kombinieren – kein Entweder-oder.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Social-Proof-Teaser -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Erfahrungen</span>
        <h2>Was andere Betroffene berichten</h2>
        <div class="rating-line" style="justify-content:center;">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span>[PLATZHALTER: 4,X von 5 – ECHTE BEWERTUNGSZAHL EINSETZEN]</span>
        </div>
      </div>
      <div class="testimonial-grid">
        <div class="testimonial-card">
          <div class="testimonial-top">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span class="placeholder-tag">Platzhalter</span>
          </div>
          <p class="testimonial-quote">[KUNDENBEWERTUNG EINFÜGEN – Zitat, Name, Datum, Foto]</p>
          <p class="testimonial-meta">[PLATZHALTER: Name] · [PLATZHALTER: Verifizierter Kauf, Datum]</p>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-top">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span class="placeholder-tag">Platzhalter</span>
          </div>
          <p class="testimonial-quote">[KUNDENBEWERTUNG EINFÜGEN – Zitat, Name, Datum, Foto]</p>
          <p class="testimonial-meta">[PLATZHALTER: Name] · [PLATZHALTER: Verifizierter Kauf, Datum]</p>
        </div>
      </div>
      <div style="text-align:center; margin-top: var(--space-4);">
        <a href="/products/pedivita-fersenhalt" class="btn btn-primary">Zum Produkt</a>
      </div>
    </div>
  </section>

  <!-- 5. Über-uns-Teaser -->
  <section class="section">
    <div class="container split reverse">
      <div class="split-media img-placeholder" role="img" aria-label="[PLATZHALTER: Team- oder Gründerfoto]">
        [PLATZHALTER: Foto Team / Gründer]
      </div>
      <div>
        <span class="eyebrow">Über uns</span>
        <h2>Für Menschen, die schon vieles probiert haben</h2>
        <p>Wir haben AktivFuß für alle entwickelt, denen Einlagen, Dehnübungen oder Stoßwellentherapie allein nicht genug Alltag zurückgegeben haben. Ehrlich statt vollmundig, deutscher Service statt anonymer Bestellnummer.</p>
        <a href="/pages/ueber-uns-claude-code" class="btn btn-secondary">Unsere Geschichte lesen</a>
      </div>
    </div>
  </section>

</main>

{%- render 'claude-footer' -%}

