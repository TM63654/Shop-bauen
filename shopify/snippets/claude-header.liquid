{%- comment -%}
  Gemeinsamer Header für alle "Claude Code 1:1"-Seiten.
  Parameter: active = 'startseite' | 'produkt' | 'ueber-uns' | 'faq'
{%- endcomment -%}
<a class="skip-link" href="#main">Zum Inhalt springen</a>

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/pages/startseite-claude-code">
      <span class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round"><path d="M6 3v9c0 3 2 5 6 5s6-2 6-5V3"/><path d="M6 3h12"/><path d="M9 21h6"/><path d="M12 17v4"/></svg>
      </span>
      AktivFuß
    </a>
    <nav class="nav-list" aria-label="Hauptnavigation">
      <a class="nav-link{% if active == 'startseite' %} is-active{% endif %}" href="/pages/startseite-claude-code"{% if active == 'startseite' %} aria-current="page"{% endif %}>Startseite</a>
      <a class="nav-link{% if active == 'produkt' %} is-active{% endif %}" href="/products/pedivita-fersenhalt"{% if active == 'produkt' %} aria-current="page"{% endif %}>Produktseite</a>
      <a class="nav-link{% if active == 'ueber-uns' %} is-active{% endif %}" href="/pages/ueber-uns-claude-code"{% if active == 'ueber-uns' %} aria-current="page"{% endif %}>Über uns</a>
      <a class="nav-link{% if active == 'faq' %} is-active{% endif %}" href="/pages/faq-claude-code"{% if active == 'faq' %} aria-current="page"{% endif %}>FAQ</a>
    </nav>
    <div class="nav-right">
      {%- unless active == 'produkt' -%}
      <a class="btn btn-primary btn-small desktop-only" href="/products/pedivita-fersenhalt">Zum Produkt</a>
      {%- endunless -%}
      <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="off-canvas-menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="off-canvas" id="off-canvas-menu" data-open="false">
  <div class="off-canvas-backdrop"></div>
  <div class="off-canvas-panel" role="dialog" aria-modal="true" aria-label="Menü">
    <button class="off-canvas-close" aria-label="Menü schließen">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <ul class="off-canvas-list">
      <li><a class="{% if active == 'startseite' %}is-active{% endif %}" href="/pages/startseite-claude-code">Startseite</a></li>
      <li><a class="{% if active == 'produkt' %}is-active{% endif %}" href="/products/pedivita-fersenhalt">Produktseite</a></li>
      <li><a class="{% if active == 'ueber-uns' %}is-active{% endif %}" href="/pages/ueber-uns-claude-code">Über uns</a></li>
      <li><a class="{% if active == 'faq' %}is-active{% endif %}" href="/pages/faq-claude-code">FAQ</a></li>
    </ul>
    {%- unless active == 'produkt' -%}
    <a class="btn btn-primary btn-block" href="/products/pedivita-fersenhalt">Zum Produkt</a>
    {%- endunless -%}
  </div>
</div>
